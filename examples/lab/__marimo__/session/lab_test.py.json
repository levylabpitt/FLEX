    {
      "id": "Hstk",
      "code_hash": "d5a1060c529e47bc9d0c8c0ed996086e",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><marimo-ui-element object-id='Hstk-0' random-id='1bbd1efb-b89c-b300-1f9d-b4cc14c6ea61'><marimo-code-editor data-initial-value='&quot;&#92;&quot;&#92;&quot;&#92;&quot;Sweep the bench gate and read x. Finishes in a few seconds.&#92;&quot;&#92;&quot;&#92;&quot;&#92;n&#92;nimport time&#92;n&#92;n&#92;ndef run(station, start=0.0, stop=1.0, points=11, delay=0.2):&#92;n    gates, xs = [], []&#92;n    try:&#92;n        for i in range(points):&#92;n            gate = start + (stop - start) * i / max(points - 1, 1)&#92;n            station.bench.gate(gate)&#92;n            gates.append(gate)&#92;n            xs.append(station.bench.x())&#92;n            print(f&#92;&quot;point {i + 1}/{points}: gate={gate:.3f} x={xs[-1]:.4f}&#92;&quot;, flush=True)&#92;n            time.sleep(delay)&#92;n    finally:&#92;n        station.bench.gate(0)&#92;n    return {&#92;&quot;gate&#92;&quot;: gates, &#92;&quot;x&#92;&quot;: xs}&#92;n&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='220' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='Hstk-1' random-id='ab52605d-1342-c3c5-546e-ad34e1b49876'><marimo-text data-initial-value='&quot;{&#92;&quot;points&#92;&quot;: 11}&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eParams (JSON)&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-placeholder='&quot;&quot;' data-kind='&quot;text&quot;' data-full-width='true' data-disabled='false' data-debounce='true'></marimo-text></marimo-ui-element><div style='display: flex;flex: 1;flex-direction: row;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><marimo-ui-element object-id='Hstk-2' random-id='44329e50-fa7f-e774-5fb3-03e3e038502f'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eRun&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;success&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-ui-element object-id='Hstk-3' random-id='c961d2f3-bee4-2ccc-7229-8c1b5e1fde37'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eAbort&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;danger&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-ui-element object-id='Hstk-4' random-id='0b7e76e1-423c-ac7b-a67a-1646311d5b6f'><marimo-refresh data-initial-value='&quot;&quot;' data-label='null' data-options='[&quot;1s&quot;,&quot;2s&quot;,&quot;5s&quot;]' data-default-interval='&quot;1s&quot;'></marimo-refresh></marimo-ui-element></div></div>"
